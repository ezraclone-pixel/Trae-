generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  telegramId String @id @map("telegramId")

  username  String?
  firstName String? @map("firstName")
  lastName  String? @map("lastName")
  photoUrl  String? @map("photoUrl")

  points         Int @default(0)
  reservedPoints Int @default(0) @map("reservedPoints")

  referrerId String? @map("referrerId")
  referrer   User?   @relation("Referrals", fields: [referrerId], references: [telegramId])
  referrals  User[]  @relation("Referrals")

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  taskCompletions TaskCompletion[]
  orders          Order[]
  withdrawals     WithdrawalRequest[]
  referralCredits ReferralCredit[] @relation("ReferrerCredits")

  @@map("User")
}

model TaskCompletion {
  id        String   @id @map("id")
  userId    String   @map("userId")
  user      User     @relation(fields: [userId], references: [telegramId], onDelete: Cascade)
  taskKey   String   @map("taskKey")
  periodKey String   @map("periodKey")
  meta      Json?    @map("meta")
  createdAt DateTime @default(now()) @map("createdAt")

  @@unique([userId, taskKey, periodKey], map: "TaskCompletion_userId_taskKey_periodKey_key")
  @@index([taskKey, periodKey], map: "TaskCompletion_taskKey_periodKey_idx")
  @@map("TaskCompletion")
}

model ReferralCredit {
  id        String   @id @map("id")
  referrerId String  @map("referrerId")
  referrer   User     @relation("ReferrerCredits", fields: [referrerId], references: [telegramId], onDelete: Cascade)
  referredId String  @unique @map("referredId")
  points     Int     @default(1500) @map("points")
  createdAt  DateTime @default(now()) @map("createdAt")

  @@map("ReferralCredit")
}

model Order {
  id        String   @id @map("id")
  userId    String   @map("userId")
  user      User     @relation(fields: [userId], references: [telegramId], onDelete: Cascade)
  category  String   @map("category")
  productKey String  @map("productKey")
  priceMMK  Int?     @map("priceMMK")
  status    String   @default("PENDING") @map("status")
  pointsEarned Int   @default(0) @map("pointsEarned")
  createdAt DateTime @default(now()) @map("createdAt")

  @@map("Order")
}

model WithdrawalRequest {
  id        String   @id @map("id")
  userId    String   @map("userId")
  user      User     @relation(fields: [userId], references: [telegramId], onDelete: Cascade)
  points    Int      @map("points")
  mmk       Int      @map("mmk")
  status    String   @default("PENDING") @map("status")
  createdAt DateTime @default(now()) @map("createdAt")
  handledAt DateTime? @map("handledAt")
  handledBy String?  @map("handledBy")
  note      String?  @map("note")

  @@index([status, createdAt], map: "WithdrawalRequest_status_createdAt_idx")
  @@map("WithdrawalRequest")
}
