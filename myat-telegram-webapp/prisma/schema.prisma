generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 💡 SQL ထဲက ပုံစံအတိုင်း ကိုက်ညီအောင် Next.js ဘက်မှာ Enums အစား String (သို့မဟုတ် Text) အဖြစ် ပြောင်းသုံးပါမယ်

model User {
  /// Telegram user id
  telegramId String @id

  username  String?
  firstName String?  // Supabase ထဲက firstName နဲ့ ကွက်တိ ကိုက်ပါမည်
  lastName  String?  // Supabase ထဲက lastName နဲ့ ကွက်တိ ကိုက်ပါမည်
  photoUrl  String?  // Supabase ထဲက photoUrl နဲ့ ကွက်တိ ကိုက်ပါမည်

  points         Int @default(0)
  reservedPoints Int @default(0)

  referrerId String?
  referrer   User?   @relation("Referrals", fields: [referrerId], references: [telegramId])
  referrals  User[]  @relation("Referrals")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskCompletions TaskCompletion[]
  orders          Order[]
  withdrawals     WithdrawalRequest[]
  referralCredits ReferralCredit[] @relation("ReferrerCredits")
}

model TaskCompletion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [telegramId], onDelete: Cascade)
  taskKey   String
  periodKey String
  meta      Json?
  createdAt DateTime @default(now())

  @@unique([userId, taskKey, periodKey])
  @@index([taskKey, periodKey])
}

model ReferralCredit {
  id        String   @id @default(cuid())
  referrerId String
  referrer   User     @relation("ReferrerCredits", fields: [referrerId], references: [telegramId], onDelete: Cascade)
  referredId String  @unique
  points     Int     @default(1500)
  createdAt  DateTime @default(now())
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [telegramId], onDelete: Cascade)
  
  // 🚀 [ပြင်ဆင်ချက်] Enum နေရာမှာ String ပြောင်းပေးရပါမယ် (SQL Editor က TEXT နဲ့ ကိုက်အောင်လို့ပါ)
  category  String
  productKey String
  priceMMK  Int?
  status    String @default("PENDING")
  
  pointsEarned Int @default(0)
  createdAt DateTime @default(now())
}

model WithdrawalRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [telegramId], onDelete: Cascade)
  points    Int
  mmk       Int
  
  // 🚀 [ပြင်ဆင်ချက်] Enum နေရာမှာ String ပြောင်းပေးရပါမယ် (SQL Editor က TEXT နဲ့ ကိုက်အောင်လို့ပါ)
  status    String @default("PENDING")
  
  createdAt DateTime @default(now())
  handledAt DateTime?
  handledBy String?
  note      String?

  @@index([status, createdAt])
}
